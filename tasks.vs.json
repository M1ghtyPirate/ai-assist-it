{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "Launch",
      "appliesTo": "/",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": [ "go run main.go" ]
    },
    {
      "taskLabel": "Generate Swagger Docs",
      "appliesTo": "/",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": [ "swag init -g main.go -o docs" ]
    },
    {
      "taskLabel": "Install Swagger",
      "appliesTo": "/",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": [ "go install github.com/swaggo/swag/cmd/swag@latest" ]
    }
  ]
}